{
  "version": 1,
  "modelId": "workspace-isolation",
  "cases": [
    {
      "name": "smoke-control-workspace-isolation",
      "steps": [
        {
          "op": "CheckAggregates",
          "principal": "ownerA"
        },
        {
          "op": "ProbeGroup",
          "group": "audience",
          "principal": "ownerA",
          "target": "B"
        }
      ],
      "expected": {
        "outcome": "pass",
        "control": true
      },
      "note": "Control: ownerA aggregates match workspace A recount and audience probes against workspace B leak/mutate nothing"
    },
    {
      "name": "canary-cross-workspace-leak",
      "steps": [
        {
          "op": "ProbeGroup",
          "group": "audience",
          "principal": "ownerA",
          "target": "B"
        }
      ],
      "bug": "canary_cross_workspace_leak",
      "expected": {
        "outcome": "fail",
        "operator": "reply:ProbeGroup:satisfies:no-cross-workspace-violation",
        "verdict": "replyMismatch",
        "canary": true
      },
      "note": "Canary: planted workspace B marker leak into workspace A response fails no-cross-workspace-violation"
    },
    {
      "name": "canary-cross-workspace-write",
      "steps": [
        {
          "op": "ProbeGroup",
          "group": "ops",
          "principal": "ownerA",
          "target": "B"
        }
      ],
      "bug": "canary_cross_workspace_write",
      "expected": {
        "outcome": "fail",
        "operator": "reply:ProbeGroup:satisfies:no-cross-workspace-violation",
        "verdict": "replyMismatch",
        "canary": true
      },
      "note": "Canary: planted mutation of workspace B operation_settings fails snapshot comparison"
    },
    {
      "name": "canary-id-probe-oracle",
      "steps": [
        {
          "op": "ProbeGroup",
          "group": "audience",
          "principal": "ownerA",
          "target": "B"
        }
      ],
      "bug": "canary_id_probe_oracle",
      "expected": {
        "outcome": "fail",
        "operator": "reply:ProbeGroup:satisfies:no-cross-workspace-violation",
        "verdict": "replyMismatch",
        "canary": true
      },
      "note": "Canary: planted 403 vs 404 oracle on foreign ID fails indistinguishability check"
    },
    {
      "name": "known-bug-iso-01-support-audience-health-leaks-all-imports",
      "steps": [
        {
          "op": "ProbeSupport",
          "principal": "supportA",
          "scope": "audience-health",
          "target": "B"
        }
      ],
      "expected": {
        "outcome": "fail",
        "operator": "reply:ProbeSupport:satisfies:no-cross-workspace-violation",
        "verdict": "replyMismatch",
        "canary": true
      },
      "note": "Known product bug BUG-ISO-01 (PR #591, unmerged on api/tear-update base 24333f2c): GET /v1/support/audience/health reads base table audience_imports instead of scoped CTE i, leaking every workspace's imports and list names"
    },
    {
      "name": "known-bug-iso-02-campaign-accepts-foreign-audience-ids",
      "steps": [
        {
          "op": "DualMismatch",
          "header": "A",
          "target": "B",
          "focus": "campaign-audience"
        }
      ],
      "expected": {
        "outcome": "fail",
        "operator": "reply:DualMismatch:satisfies:no-cross-workspace-violation",
        "verdict": "replyMismatch",
        "canary": true
      },
      "note": "Known product bug BUG-ISO-02 (PR #597 class): POST /v1/campaigns and PATCH /v1/campaigns/{id} accept and persist foreign workspace listId/segmentId/excludeListIds/excludeSegmentIds without workspace ownership check"
    },
