{
  "version": 1,
  "modelId": "workspace-isolation",
  "cases": [
    {
      "name": "smoke-control-workspace-isolation",
      "steps": [
        {
          "op": "CheckAggregates",
          "principal": "ownerA"
        },
        {
          "op": "ProbeGroup",
          "group": "audience",
          "principal": "ownerA",
          "target": "B"
        }
      ],
      "expected": {
        "outcome": "pass",
        "control": true
      },
      "note": "Control: ownerA aggregates match workspace A recount and audience probes against workspace B leak/mutate nothing"
    },
    {
      "name": "canary-cross-workspace-leak",
      "steps": [
        {
          "op": "ProbeGroup",
          "group": "audience",
          "principal": "ownerA",
          "target": "B"
        }
      ],
      "bug": "canary_cross_workspace_leak",
      "expected": {
        "outcome": "fail",
        "operator": "reply:ProbeGroup:satisfies:no-cross-workspace-violation",
        "verdict": "replyMismatch",
        "canary": true
      },
      "note": "Canary: planted workspace B marker leak into workspace A response fails no-cross-workspace-violation"
    },
    {
      "name": "canary-cross-workspace-write",
      "steps": [
        {
          "op": "ProbeGroup",
          "group": "ops",
          "principal": "ownerA",
          "target": "B"
        }
      ],
      "bug": "canary_cross_workspace_write",
      "expected": {
        "outcome": "fail",
        "operator": "reply:ProbeGroup:satisfies:no-cross-workspace-violation",
        "verdict": "replyMismatch",
        "canary": true
      },
      "note": "Canary: planted mutation of workspace B operation_settings fails snapshot comparison"
    },
    {
      "name": "canary-id-probe-oracle",
      "steps": [
        {
          "op": "ProbeGroup",
          "group": "audience",
          "principal": "ownerA",
          "target": "B"
        }
      ],
      "bug": "canary_id_probe_oracle",
      "expected": {
        "outcome": "fail",
        "operator": "reply:ProbeGroup:satisfies:no-cross-workspace-violation",
        "verdict": "replyMismatch",
        "canary": true
      },
      "note": "Canary: planted 403 vs 404 oracle on foreign ID fails indistinguishability check"
    },
    {
      "name": "fixed-bug-iso-01-support-audience-health-scoped",
      "steps": [
        {
          "op": "ProbeSupport",
          "principal": "supportA",
          "target": "B"
        },
        {
          "op": "CheckAggregates",
          "principal": "supportA"
        }
      ],
      "expected": {
        "outcome": "pass"
      },
      "note": "Regression for BUG-ISO-01 (PR #591, live on dev): GET /v1/support/audience/health returns only caller workspace's committed imports"
    },
    {
      "name": "fixed-bug-iso-02-and-03-dual-body-writes",
      "steps": [
        {
          "op": "ProbeFields",
          "principal": "ownerA",
          "target": "B",
          "focus": "body-writes"
        },
        {
          "op": "ProbeFields",
          "principal": "dualA",
          "target": "B",
          "focus": "body-writes"
        },
        {
          "op": "ProbeFields",
          "principal": "dualB",
          "target": "A",
          "focus": "body-writes"
        }
      ],
      "expected": {
        "outcome": "pass"
      },
      "note": "Regression for BUG-ISO-02 (#611 campaigns) & BUG-ISO-03 (#612 inbound webhooks) + all ID-carrying body write fields (real foreign ID vs nonexistent ID identical)"
    },
    {
      "name": "all-query-id-fields-indistinguishable",
      "steps": [
        {
          "op": "ProbeFields",
          "principal": "ownerA",
          "target": "B",
          "focus": "query-reads"
        },
        {
          "op": "ProbeFields",
          "principal": "dualA",
          "target": "B",
          "focus": "query-reads"
        },
        {
          "op": "ProbeFields",
          "principal": "keyA",
          "target": "B",
          "focus": "query-reads"
        }
      ],
      "expected": {
        "outcome": "pass"
      },
      "note": "Every ID-carrying query parameter returns identical answers for foreign real IDs and nonexistent IDs with zero leaks"
    },
    {
      "name": "known-bug-iso-04-pr614-rules-optins-and-all-addr-key",
      "steps": [
        {
          "op": "ProbeFields",
          "principal": "ownerA",
          "target": "B",
          "focus": "pr614-bug-iso-04"
        }
      ],
      "expected": {
        "outcome": "fail",
        "operator": "reply:ProbeFields:satisfies:no-cross-workspace-violation",
        "verdict": "replyMismatch",
        "canary": true
      },
      "note": "Known bug BUG-ISO-04 (fixed in approved PR #614, waiting to merge onto dev): PUT /v1/rules & /v1/rules/decisions accept foreign evaluateRoutes/evaluateDomains; PATCH /v1/api-keys/{allAddrKey} accepts foreign addAddressIds; ended inboxes accepted"
    },
    {
      "name": "nearby-foreign-ended-inboxes-refused",
      "steps": [
        {
          "op": "ProbeFields",
          "principal": "ownerA",
          "target": "B",
          "focus": "nearby-foreign-ended"
        }
      ],
      "expected": {
        "outcome": "pass"
      },
      "note": "Foreign ended/deleted ephemeral inbox IDs are refused identically to nonexistent IDs across rules/attachments, routing, API keys, and inbound webhooks"
    },
    {
      "name": "nearby-own-ended-inbox-accepted-in-rules-and-routing",
      "steps": [
        {
          "op": "ProbeFields",
          "principal": "ownerA",
          "target": "B",
          "focus": "nearby-own-ended"
        }
      ],
      "expected": {
        "outcome": "fail",
        "operator": "reply:ProbeFields:satisfies:no-cross-workspace-violation",
        "verdict": "replyMismatch",
        "canary": true
      },
      "note": "Reviewer-noted nearby cases (own workspace only, nothing crosses): PUT /v1/rules/attachments and POST /v1/routing/routes accept an own just-deleted ephemeral inbox until GC cleanup"
    },
